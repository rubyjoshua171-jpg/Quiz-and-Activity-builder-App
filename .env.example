# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Supabase (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: never add the NEXT_PUBLIC_ prefix to these
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# true = /api/generate returns a saved sample instead of calling the AI
FAKE_MODE=true
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=